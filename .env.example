# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (SQLite - local file-based)
DATABASE_URL=sqlite:///./campus_notifications.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0
DEBUG=True

# Email Configuration (for bulk notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notification API
NOTIFICATION_API_URL=http://20.207.122.201/evaluation-service/notifications
NOTIFICATION_API_TOKEN=your-bearer-token

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/notification_system.log
